# Copy this file to .env.local for local development.
#
# VITE_API_URL: base URL of the RESOLVE backend (no trailing slash).
# Optional. When unset, production builds use the hosted backend
# (https://raone777-resolve-backend.hf.space) and `npm run dev` uses http://localhost:8000.
# The hosted Space sleeps when idle, so the first request can take 20-60 s.
VITE_API_URL="https://raone777-resolve-backend.hf.space"
